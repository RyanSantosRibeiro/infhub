# Public frontend URL (use your HTTPS staging/production domain for checkout).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_URL=

# Supabase project settings. The service role key is SERVER ONLY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Checkout Pro via Preferences API. Start with an isolated test seller/buyer.
MERCADOPAGO_ENVIRONMENT=sandbox
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COLLECTOR_ID=

# Random secret with at least 32 bytes; send as Authorization: Bearer <secret>.
GENERATION_JOB_SECRET=

# Required only to sell AI Custom. Never prefix private keys with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
